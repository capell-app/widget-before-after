{
    "name": "capell-app/widget-before-after",
    "description": "Accessible before and after image comparison widget for Capell.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "capell-app/admin": "^1.0 || 1.x-dev",
        "capell-app/core": "^1.0 || 1.x-dev",
        "capell-app/frontend": "^1.0 || 1.x-dev",
        "capell-app/layout-builder": "^1.0 || 1.x-dev",
        "spatie/laravel-package-tools": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Capell\\WidgetBeforeAfter\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\WidgetBeforeAfter\\Providers\\WidgetBeforeAfterServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true
}
